<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/tienda_maquillaje_db</property>
        <property name="hibernate.connection.username">postgres</property>
        <property name="hibernate.connection.password">1234</property>

        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Entidades Mapeadas -->
        <mapping class="ni.edu.uam.proyectopae.models.Usuario"/>
        <mapping class="ni.edu.uam.proyectopae.models.Cliente"/>
        <mapping class="ni.edu.uam.proyectopae.models.Categoria"/>
        <mapping class="ni.edu.uam.proyectopae.models.Marca"/>
        <mapping class="ni.edu.uam.proyectopae.models.Producto"/>
        <mapping class="ni.edu.uam.proyectopae.models.Lote"/>
        <mapping class="ni.edu.uam.proyectopae.models.Servicio"/>
        <mapping class="ni.edu.uam.proyectopae.models.Cita"/>
        <mapping class="ni.edu.uam.proyectopae.models.ConsumoInsumo"/>
    </session-factory>
</hibernate-configuration>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefWidth="980" prefHeight="650"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.ReporteController">

    <top>
        <HBox styleClass="header-bar, bg-morado">
            <FontIcon iconLiteral="fas-file-alt" iconSize="30"/>
            <Label text="Reportes de citas" styleClass="header-title"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="content-area">
            <VBox fx:id="configuracion" spacing="12" styleClass="card">
                <Label text="Filtros" styleClass="card-title"/>

                <FlowPane hgap="12" vgap="8">
                    <VBox spacing="4">
                        <Label text="Desde" styleClass="form-label"/>
                        <DatePicker fx:id="dpDesde" editable="false" prefWidth="150"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Hasta" styleClass="form-label"/>
                        <DatePicker fx:id="dpHasta" editable="false" prefWidth="150"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Servicio" styleClass="form-label"/>
                        <ComboBox fx:id="cmbServicio" prefWidth="270"/>
                    </VBox>
                </FlowPane>

                <Label text="Columnas a incluir" styleClass="form-label"/>

                <FlowPane hgap="16" vgap="8">
                    <CheckBox fx:id="chkId" text="N.º de cita" selected="true"/>
                    <CheckBox fx:id="chkFecha" text="Fecha y hora" selected="true"/>
                    <CheckBox fx:id="chkCliente" text="Cliente" selected="true"/>
                    <CheckBox fx:id="chkServicio" text="Servicio" selected="true"/>
                    <CheckBox fx:id="chkEstado" text="Estado" selected="true"/>
                </FlowPane>

                <HBox spacing="10">
                    <Button text="Generar reporte" onAction="#generarReporte"
                            defaultButton="true" styleClass="btn-primary"/>
                    <Button text="Limpiar filtros" onAction="#limpiarFiltros"
                            styleClass="btn-secondary"/>
                </HBox>
            </VBox>

            <VBox spacing="10" styleClass="card" VBox.vgrow="ALWAYS">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Vista previa" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnExportar" text="Exportar CSV"
                            onAction="#exportarCsv" styleClass="btn-success"/>
                </HBox>

                <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="No hay citas para mostrar."/>
                    </placeholder>
                    <columns>
                        <TableColumn fx:id="colId" text="N.º de cita" prefWidth="85"/>
                        <TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="180"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
                        <TableColumn fx:id="colServicio" text="Servicio" prefWidth="245"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="135"/>
                    </columns>
                </TableView>

                <Label fx:id="lblEstado" text="Pulsa Generar reporte para ver los resultados."
                       styleClass="hint-label"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
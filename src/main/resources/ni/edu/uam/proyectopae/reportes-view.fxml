<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.ReporteController" styleClass="pae-ui">
    <top>
        <VBox styleClass="encabezado-modulo" spacing="5">
            <Label text="Reportes generales" styleClass="header-title"/>
            <Label text="Elegí los apartados y campos que querés incluir; revisalos y exportá en PDF o CSV."
                   styleClass="header-subtitle" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <HBox styleClass="content-area" spacing="18" alignment="TOP_LEFT" minWidth="820">
                <VBox fx:id="configuracion" spacing="10" styleClass="card" prefWidth="350" minWidth="330" maxWidth="350">
                    <Label text="Filtros" styleClass="card-title"/>
                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="Desde" styleClass="form-label"/>
                            <DatePicker fx:id="dpDesde" editable="false" promptText="Sin límite" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="Hasta" styleClass="form-label"/>
                            <DatePicker fx:id="dpHasta" editable="false" promptText="Sin límite" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <ComboBox fx:id="cmbServicio" maxWidth="Infinity" accessibleText="Filtrar por servicio"/>
                    <Label text="Fechas: ventas, citas, consumos e ingreso de lotes. Servicio: servicios, citas, consumos y citas del resumen."
                           styleClass="hint-label" wrapText="true" minHeight="-Infinity"/>
                    <Button fx:id="btnLimpiar" text="Limpiar filtros" onAction="#limpiarFiltros" styleClass="btn-ghost"/>
                    <Region styleClass="separador" minHeight="1" maxHeight="1"/>
                    <Label text="Apartados y campos" styleClass="card-title"/>
                    <Label text="Marcá los apartados. Desplegá cada uno con la flecha para elegir sus campos."
                           styleClass="hint-label" wrapText="true" minHeight="-Infinity"/>
                    <HBox spacing="8">
                        <Button fx:id="btnTodos" text="Seleccionar todo" onAction="#seleccionarTodos" styleClass="btn-ghost"/>
                        <Button fx:id="btnNinguno" text="Ninguno" onAction="#desmarcarTodos" styleClass="btn-ghost"/>
                    </HBox>
                    <Label fx:id="lblSeleccion" styleClass="hint-label" wrapText="true" minHeight="-Infinity"/>
                    <ScrollPane fitToWidth="true" minHeight="170" prefHeight="315" VBox.vgrow="ALWAYS">
                        <VBox fx:id="listaApartados" spacing="5"/>
                    </ScrollPane>
                    <Button fx:id="btnGenerar" text="Generar reporte" onAction="#generarReporte" maxWidth="Infinity"
                            defaultButton="true" styleClass="btn-primary">
                        <graphic><FontIcon iconLiteral="fas-file-alt" iconSize="14"/></graphic>
                    </Button>
                </VBox>
                <VBox spacing="14" styleClass="card" HBox.hgrow="ALWAYS" minWidth="360" minHeight="560">
                    <FlowPane hgap="10" vgap="10" alignment="CENTER_LEFT">
                        <Label text="Vista previa" styleClass="card-title"/>
                        <Button fx:id="btnImprimir" text="Imprimir" onAction="#imprimirReporte" styleClass="btn-primary">
                            <graphic><FontIcon iconLiteral="fas-print" iconSize="14"/></graphic>
                            <tooltip><Tooltip text="Previsualizar el PDF para imprimirlo o guardarlo"/></tooltip>
                        </Button>
                        <Button fx:id="btnExportar" text="Exportar PDF / CSV" onAction="#exportarReporte" styleClass="btn-secondary">
                            <graphic><FontIcon iconLiteral="fas-download" iconSize="14"/></graphic>
                        </Button>
                        <ProgressIndicator fx:id="progreso" prefWidth="24" prefHeight="24" maxWidth="24" maxHeight="24"/>
                    </FlowPane>
                    <Label fx:id="lblResumen" text="Generá el reporte para consultar los apartados seleccionados."
                           styleClass="hint-label" wrapText="true" minHeight="-Infinity" maxWidth="Infinity"/>
                    <VBox fx:id="panelSinResultados" alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS" minHeight="240">
                        <FontIcon iconLiteral="far-file-alt" iconSize="30"/>
                        <Label text="Prepará tu reporte" styleClass="card-title"/>
                        <Label text="Seleccioná los apartados y pulsá Generar reporte. Cada apartado tendrá su propia pestaña."
                               styleClass="hint-label" wrapText="true" minHeight="-Infinity" textAlignment="CENTER" maxWidth="360"/>
                    </VBox>
                    <TabPane fx:id="vistaPrevia" tabClosingPolicy="UNAVAILABLE" tabMinWidth="120" tabMaxWidth="260"
                             minHeight="260" VBox.vgrow="ALWAYS"/>
                    <Label text="PDF: una sección por apartado. CSV: columnas Apartado, Registro, Campo y Valor; una fila por campo seleccionado."
                           styleClass="hint-label" wrapText="true" minHeight="-Infinity"/>
                    <Label fx:id="lblEstado" text="Pulsa Generar reporte para ver los resultados."
                           styleClass="estado-reporte, modo-label" maxWidth="Infinity" wrapText="true" minHeight="-Infinity"/>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="pae-ui" prefWidth="1280.0" prefHeight="780.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.CatalogoProveedorController">

    <top>
        <HBox styleClass="encabezado-modulo" spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Catálogo del proveedor (API REST)" styleClass="header-title"/>
                <Label text="Consulta y administra el catálogo externo del proveedor mediante servicios web. Datos simulados por la API api-catalogo."
                       styleClass="header-subtitle" wrapText="true"/>
            </VBox>
            <HBox spacing="6" alignment="CENTER" styleClass="chip-verde">
                <FontIcon iconLiteral="fas-cloud" iconSize="14"/>
                <Label fx:id="lblApiUrl" styleClass="badge-verde"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <HBox styleClass="content-area" spacing="18" minWidth="900" minHeight="590" alignment="TOP_LEFT">

                <!-- Consulta del catálogo -->
                <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Productos del proveedor" styleClass="card-title">
                            <graphic><FontIcon iconLiteral="fas-store" iconSize="16"/></graphic>
                        </Label>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ProgressIndicator fx:id="indicadorCarga" prefWidth="24" prefHeight="24"/>
                    </HBox>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txtBuscar" promptText="Buscar por nombre, marca o código..."
                                   onAction="#handleBuscar" HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="cmbCategoria" prefWidth="200"/>
                        <Button text="Buscar" onAction="#handleBuscar" styleClass="btn-primary">
                            <graphic><FontIcon iconLiteral="fas-search" iconSize="14"/></graphic>
                        </Button>
                        <Button text="Limpiar" onAction="#handleLimpiarFiltros" styleClass="btn-secondary">
                            <graphic><FontIcon iconLiteral="fas-eraser" iconSize="14"/></graphic>
                        </Button>
                    </HBox>

                    <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS" minHeight="260">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        <placeholder><Label text="Sin productos para mostrar"/></placeholder>
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50" minWidth="45" maxWidth="70"/>
                            <TableColumn fx:id="colCodigo" text="Código" prefWidth="85"/>
                            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="230"/>
                            <TableColumn fx:id="colMarca" text="Marca" prefWidth="120"/>
                            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="140"/>
                            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="95"/>
                            <TableColumn fx:id="colExistencias" text="Existencias" prefWidth="90"/>
                        </columns>
                    </TableView>
                    <Label fx:id="lblResultados" styleClass="hint-label"/>

                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Consultar por ID:" styleClass="form-label"/>
                        <TextField fx:id="txtIdConsulta" promptText="Ej: 1" prefWidth="90" onAction="#handleConsultarPorId"/>
                        <Button text="Ver detalle (GET /{id})" onAction="#handleConsultarPorId" styleClass="btn-secondary">
                            <graphic><FontIcon iconLiteral="fas-info-circle" iconSize="14"/></graphic>
                        </Button>
                    </HBox>

                    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="resumen-total">
                        <FontIcon iconLiteral="fas-exchange-alt" iconSize="14"/>
                        <Label text="Última solicitud:" styleClass="form-label"/>
                        <Label fx:id="lblEstadoHttp" styleClass="hint-label" wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Detalle y formulario -->
                <VBox styleClass="card" spacing="8" prefWidth="360" minWidth="330" maxHeight="-Infinity">
                    <Label fx:id="lblModo" text="Nuevo producto del proveedor" styleClass="card-title"/>
                    <Label text="Selecciona una fila para ver su detalle desde la API." styleClass="hint-label" wrapText="true"/>

                    <HBox spacing="10">
                        <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="Código *" styleClass="form-label"/>
                            <TextField fx:id="txtCodigo" promptText="Ej: PRV-020"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="Marca *" styleClass="form-label"/>
                            <TextField fx:id="txtMarca" promptText="Ej: NYX"/>
                        </VBox>
                    </HBox>

                    <Label text="Nombre *" styleClass="form-label"/>
                    <TextField fx:id="txtNombre" promptText="Nombre del producto"/>

                    <Label text="Categoría *" styleClass="form-label"/>
                    <TextField fx:id="txtCategoria" promptText="Ej: Labiales"/>

                    <HBox spacing="10">
                        <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="Precio (C$) *" styleClass="form-label"/>
                            <TextField fx:id="txtPrecio" promptText="Ej: 450.50"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="Existencias *" styleClass="form-label"/>
                            <TextField fx:id="txtExistencias" promptText="Ej: 10"/>
                        </VBox>
                    </HBox>

                    <Label text="Descripción" styleClass="form-label"/>
                    <TextArea fx:id="txtDescripcion" promptText="Detalle breve del producto" prefRowCount="2" wrapText="true"/>

                    <HBox spacing="8">
                        <Button fx:id="btnGuardar" text="Registrar (POST)" onAction="#handleGuardar" styleClass="btn-primary">
                            <graphic><FontIcon iconLiteral="far-save" iconSize="14"/></graphic>
                        </Button>
                        <Button text="Nuevo" onAction="#handleNuevo" styleClass="btn-secondary">
                            <graphic><FontIcon iconLiteral="fas-plus" iconSize="14"/></graphic>
                        </Button>
                    </HBox>
                    <Button text="Eliminar (DELETE)" onAction="#handleEliminar" styleClass="btn-danger">
                        <graphic><FontIcon iconLiteral="far-trash-alt" iconSize="14"/></graphic>
                    </Button>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>
</BorderPane>
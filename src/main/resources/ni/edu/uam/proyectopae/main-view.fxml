<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.*?>
<?import ni.edu.uam.proyectopae.util.Icono?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.MainViewController">

    <!-- ===================== Menú de navegación ===================== -->
    <top>
        <MenuBar><properties estilo="barra-menu"/>
            <Menu text="Archivo">
                <MenuItem text="Actualizar panel" onAction="#handleActualizar">
                    <graphic><Icono tipo="REFRESCAR"/></graphic>
                    <accelerator><KeyCodeCombination alt="UP" code="F5" control="UP" meta="UP" shift="UP" shortcut="UP"/></accelerator>
                </MenuItem>
                <SeparatorMenuItem/>
                <MenuItem text="Cerrar sesión" onAction="#handleCerrarSesion">
                    <graphic><Icono tipo="SALIR"/></graphic>
                </MenuItem>
                <MenuItem text="Salir del sistema" onAction="#handleSalir">
                    <graphic><Icono tipo="CANCELAR"/></graphic>
                </MenuItem>
            </Menu>
            <Menu text="Módulos">
                <MenuItem text="Clientes" onAction="#abrirClientes">
                    <graphic><Icono tipo="CLIENTES"/></graphic>
                    <accelerator><KeyCodeCombination alt="UP" code="DIGIT1" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                </MenuItem>
                <MenuItem text="Catálogo de Productos" onAction="#abrirProductos">
                    <graphic><Icono tipo="PRODUCTOS"/></graphic>
                    <accelerator><KeyCodeCombination alt="UP" code="DIGIT2" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                </MenuItem>
                <MenuItem text="Lotes y Caducidad" onAction="#abrirLotes">
                    <graphic><Icono tipo="LOTES"/></graphic>
                    <accelerator><KeyCodeCombination alt="UP" code="DIGIT3" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                </MenuItem>
                <MenuItem text="Ventas" onAction="#abrirVentas">
                    <graphic><Icono tipo="VENTAS"/></graphic>
                    <accelerator><KeyCodeCombination alt="UP" code="DIGIT4" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                </MenuItem>
                <MenuItem text="Agenda de Citas" onAction="#abrirAgenda">
                    <graphic><Icono tipo="AGENDA"/></graphic>
                    <accelerator><KeyCodeCombination alt="UP" code="DIGIT5" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                </MenuItem>
            </Menu>
            <Menu text="Ayuda">
                <MenuItem text="Acerca del sistema" onAction="#handleAcercaDe">
                    <graphic><Icono tipo="INFO"/></graphic>
                </MenuItem>
            </Menu>
        </MenuBar>
    </top>

    <!-- ===================== Barra lateral ===================== -->
    <left>
        <VBox><properties estilo="sidebar"/>
            <Label text="Tienda de Maquillaje"><properties estilo="sidebar-titulo"/>
                <graphic><Icono tipo="ESTRELLA" tamano="20"/></graphic>
            </Label>
            <Label fx:id="lblUsuario"><properties estilo="sidebar-usuario"/>
                <graphic><Icono tipo="PERSONA" tamano="14"/></graphic>
            </Label>

            <Label text="PRINCIPAL"><properties estilo="sidebar-seccion"/></Label>
            <Button text="Dashboard" onAction="#handleActualizar"><properties estilo="nav-button activo"/>
                <graphic><Icono tipo="DASHBOARD" tamano="18"/></graphic>
            </Button>

            <Label text="MÓDULOS"><properties estilo="sidebar-seccion"/></Label>
            <Button text="Clientes" onAction="#abrirClientes"><properties estilo="nav-button"/>
                <graphic><Icono tipo="CLIENTES" tamano="18"/></graphic>
            </Button>
            <Button text="Catálogo de Productos" onAction="#abrirProductos"><properties estilo="nav-button"/>
                <graphic><Icono tipo="PRODUCTOS" tamano="18"/></graphic>
            </Button>
            <Button text="Lotes y Caducidad" onAction="#abrirLotes"><properties estilo="nav-button"/>
                <graphic><Icono tipo="LOTES" tamano="18"/></graphic>
            </Button>
            <Button text="Ventas" onAction="#abrirVentas"><properties estilo="nav-button"/>
                <graphic><Icono tipo="VENTAS" tamano="18"/></graphic>
            </Button>
            <Button text="Agenda de Citas" onAction="#abrirAgenda"><properties estilo="nav-button"/>
                <graphic><Icono tipo="AGENDA" tamano="18"/></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Cerrar sesión" onAction="#handleCerrarSesion"><properties estilo="nav-button"/>
                <graphic><Icono tipo="SALIR" tamano="18"/></graphic>
            </Button>
        </VBox>
    </left>

    <!-- ===================== Panel de control ===================== -->
    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT"><properties estilo="barra-superior"/>
                    <VBox>
                        <Label text="Panel de control"><properties estilo="titulo-modulo"/></Label>
                        <Label fx:id="lblActualizado"><properties estilo="subtitulo-modulo"/></Label>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Actualizar" onAction="#handleActualizar"><properties estilo="btn-secundario"/>
                        <graphic><Icono tipo="REFRESCAR"/></graphic>
                        <tooltip><Tooltip text="Recalcular indicadores desde la base de datos (F5)"/></tooltip>
                    </Button>
                </HBox>
            </top>

            <center>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
                    <VBox><properties estilo="dashboard-contenido"/>

                        <!-- Indicadores principales -->
                        <HBox spacing="14">
                            <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity"><properties estilo="kpi kpi-info"/>
                                <Label text="Ingresos totales"><properties estilo="kpi-etiqueta"/><graphic><Icono tipo="DINERO"/></graphic></Label>
                                <Label fx:id="lblKpiIngresos" text="C$ 0.00"><properties estilo="kpi-valor"/></Label>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity"><properties estilo="kpi kpi-alerta"/>
                                <Label text="Costos totales"><properties estilo="kpi-etiqueta"/><graphic><Icono tipo="VENTAS"/></graphic></Label>
                                <Label fx:id="lblKpiCostos" text="C$ 0.00"><properties estilo="kpi-valor"/></Label>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity"><properties estilo="kpi kpi-ok"/>
                                <Label text="Ganancia total"><properties estilo="kpi-etiqueta"/><graphic><Icono tipo="TENDENCIA"/></graphic></Label>
                                <Label fx:id="lblKpiGanancia" text="C$ 0.00"><properties estilo="kpi-valor"/></Label>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity"><properties estilo="kpi kpi-peligro"/>
                                <Label text="Lotes vencidos"><properties estilo="kpi-etiqueta"/><graphic><Icono tipo="ERROR"/></graphic></Label>
                                <Label fx:id="lblKpiVencidos" text="0"><properties estilo="kpi-valor"/></Label>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity"><properties estilo="kpi kpi-alerta"/>
                                <Label fx:id="lblKpiPorVencerTitulo" text="Próximos a vencer"><properties estilo="kpi-etiqueta"/><graphic><Icono tipo="RELOJ"/></graphic></Label>
                                <Label fx:id="lblKpiPorVencer" text="0"><properties estilo="kpi-valor"/></Label>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" maxWidth="Infinity"><properties estilo="kpi kpi-peligro"/>
                                <Label text="Bajo el mínimo"><properties estilo="kpi-etiqueta"/><graphic><Icono tipo="ADVERTENCIA"/></graphic></Label>
                                <Label fx:id="lblKpiBajoMinimo" text="0"><properties estilo="kpi-valor"/></Label>
                            </VBox>
                        </HBox>

                        <!-- ============ A y B: Inventario ============ -->
                        <Label text="Inventario"><properties estilo="titulo-grupo"/>
                            <graphic><Icono tipo="INVENTARIO" tamano="20"/></graphic>
                        </Label>
                        <GridPane hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="55"/>
                                <ColumnConstraints percentWidth="45"/>
                            </columnConstraints>

                            <VBox spacing="10" GridPane.columnIndex="0"><properties estilo="card"/>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Productos próximos a vencer"><properties estilo="titulo-seccion"/>
                                        <graphic><Icono tipo="RELOJ" tamano="18"/></graphic>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Gestionar lotes" onAction="#abrirLotes"><properties estilo="btn-secundario"/>
                                        <graphic><Icono tipo="LOTES"/></graphic>
                                    </Button>
                                </HBox>
                                <Label fx:id="lblAyudaVencimientos" wrapText="true"><properties estilo="texto-ayuda"/></Label>
                                <TableView fx:id="tblVencimientos" prefHeight="250">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                                    <placeholder><Label text="No hay productos vencidos ni próximos a vencer."><properties estilo="texto-ayuda"/></Label></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colVenProducto" text="Producto" prefWidth="180"/>
                                        <TableColumn fx:id="colVenLote" text="Lote" prefWidth="100"/>
                                        <TableColumn fx:id="colVenCantidad" text="Cantidad" prefWidth="75"/>
                                        <TableColumn fx:id="colVenFecha" text="Vence" prefWidth="95"/>
                                        <TableColumn fx:id="colVenEstado" text="Estado" prefWidth="150"/>
                                    </columns>
                                </TableView>
                                <BarChart fx:id="chartVencimientos" title="Unidades vencidas y por vencer por producto"
                                          animated="false" legendSide="BOTTOM" prefHeight="250" minHeight="220">
                                    <xAxis><CategoryAxis/></xAxis>
                                    <yAxis><NumberAxis label="Unidades" minorTickVisible="false"/></yAxis>
                                </BarChart>
                            </VBox>

                            <VBox spacing="10" GridPane.columnIndex="1"><properties estilo="card"/>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Existencias mínimas"><properties estilo="titulo-seccion"/>
                                        <graphic><Icono tipo="INVENTARIO" tamano="18"/></graphic>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Gestionar productos" onAction="#abrirProductos"><properties estilo="btn-secundario"/>
                                        <graphic><Icono tipo="PRODUCTOS"/></graphic>
                                    </Button>
                                </HBox>
                                <Label text="Existencias vigentes (lotes no vencidos) comparadas con el mínimo configurado en cada producto." wrapText="true"><properties estilo="texto-ayuda"/></Label>
                                <TableView fx:id="tblStock" VBox.vgrow="ALWAYS" prefHeight="520">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                                    <placeholder><Label text="No hay productos registrados."><properties estilo="texto-ayuda"/></Label></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colStockProducto" text="Producto" prefWidth="180"/>
                                        <TableColumn fx:id="colStockActual" text="Existencias" prefWidth="85"/>
                                        <TableColumn fx:id="colStockMinimo" text="Mínimo" prefWidth="70"/>
                                        <TableColumn fx:id="colStockEstado" text="Estado" prefWidth="130"/>
                                    </columns>
                                </TableView>
                            </VBox>
                        </GridPane>

                        <!-- ============ C: Finanzas ============ -->
                        <Label text="Finanzas"><properties estilo="titulo-grupo"/>
                            <graphic><Icono tipo="DINERO" tamano="20"/></graphic>
                        </Label>
                        <GridPane hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="34"/>
                                <ColumnConstraints percentWidth="66"/>
                            </columnConstraints>

                            <VBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="0"><properties estilo="card"/>
                                <Label text="Resumen financiero"><properties estilo="titulo-seccion"/>
                                    <graphic><Icono tipo="DINERO" tamano="18"/></graphic>
                                </Label>
                                <GridPane hgap="10" vgap="9">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints halignment="RIGHT"/>
                                    </columnConstraints>
                                    <Label text="Ingresos por venta de productos" GridPane.rowIndex="0"/>
                                    <Label fx:id="lblIngresosProductos" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                    <Label text="Costo de productos vendidos" GridPane.rowIndex="1"/>
                                    <Label fx:id="lblCostosProductos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    <Label text="Ingresos por servicios realizados" GridPane.rowIndex="2"/>
                                    <Label fx:id="lblIngresosServicios" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                    <Label text="Costo de insumos en servicios" GridPane.rowIndex="3"/>
                                    <Label fx:id="lblCostosServicios" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                    <Separator GridPane.rowIndex="4" GridPane.columnSpan="2"/>
                                    <Label text="Ingresos totales" GridPane.rowIndex="5"><properties estilo="etiqueta-campo"/></Label>
                                    <Label fx:id="lblIngresosTotales" GridPane.rowIndex="5" GridPane.columnIndex="1"><properties estilo="etiqueta-campo"/></Label>
                                    <Label text="Costos totales" GridPane.rowIndex="6"><properties estilo="etiqueta-campo"/></Label>
                                    <Label fx:id="lblCostosTotales" GridPane.rowIndex="6" GridPane.columnIndex="1"><properties estilo="etiqueta-campo"/></Label>
                                    <Label text="Ganancia total" GridPane.rowIndex="7"><properties estilo="titulo-seccion"/></Label>
                                    <Label fx:id="lblGananciaTotal" GridPane.rowIndex="7" GridPane.columnIndex="1"><properties estilo="total-venta"/></Label>
                                    <Label text="Margen de ganancia" GridPane.rowIndex="8"/>
                                    <Label fx:id="lblMargen" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                                </GridPane>
                                <Label text="Ingresos = ventas registradas + citas marcadas como realizadas. Los costos usan el precio de compra guardado en cada venta." wrapText="true"><properties estilo="texto-ayuda"/></Label>
                            </VBox>

                            <VBox spacing="10" GridPane.rowIndex="0" GridPane.columnIndex="1"><properties estilo="card"/>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Rentabilidad por producto"><properties estilo="titulo-seccion"/>
                                        <graphic><Icono tipo="PRODUCTOS" tamano="18"/></graphic>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Registrar venta" onAction="#abrirVentas"><properties estilo="btn-secundario"/>
                                        <graphic><Icono tipo="VENTAS"/></graphic>
                                    </Button>
                                </HBox>
                                <TableView fx:id="tblFinanzas" VBox.vgrow="ALWAYS" prefHeight="300">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                                    <placeholder><Label text="No hay productos registrados."><properties estilo="texto-ayuda"/></Label></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colFinProducto" text="Producto" prefWidth="170"/>
                                        <TableColumn fx:id="colFinCompra" text="P. compra" prefWidth="90"/>
                                        <TableColumn fx:id="colFinVenta" text="P. venta" prefWidth="90"/>
                                        <TableColumn fx:id="colFinGananciaUnit" text="Ganancia/u" prefWidth="90"/>
                                        <TableColumn fx:id="colFinUnidades" text="Vendidas" prefWidth="70"/>
                                        <TableColumn fx:id="colFinIngresos" text="Ingresos" prefWidth="100"/>
                                        <TableColumn fx:id="colFinCostos" text="Costos" prefWidth="100"/>
                                        <TableColumn fx:id="colFinGanancia" text="Ganancia" prefWidth="100"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0" GridPane.columnSpan="2"><properties estilo="card"/>
                                <Label fx:id="lblTituloPeriodo" text="Ingresos, costos y ganancia por mes"><properties estilo="titulo-seccion"/>
                                    <graphic><Icono tipo="GRAFICO" tamano="18"/></graphic>
                                </Label>
                                <BarChart fx:id="chartPeriodo" animated="false" legendSide="BOTTOM" prefHeight="300" minHeight="260">
                                    <xAxis><CategoryAxis/></xAxis>
                                    <yAxis><NumberAxis label="Córdobas (C$)" minorTickVisible="false"/></yAxis>
                                </BarChart>
                            </VBox>
                        </GridPane>

                        <!-- ============ D: Clientes y servicios ============ -->
                        <Label text="Clientes y servicios"><properties estilo="titulo-grupo"/>
                            <graphic><Icono tipo="ESTRELLA" tamano="20"/></graphic>
                        </Label>
                        <GridPane hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50"/>
                                <ColumnConstraints percentWidth="50"/>
                            </columnConstraints>

                            <VBox spacing="10" GridPane.columnIndex="0"><properties estilo="card"/>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Clientes que más compran"><properties estilo="titulo-seccion"/>
                                        <graphic><Icono tipo="CLIENTES" tamano="18"/></graphic>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Ver clientes" onAction="#abrirClientes"><properties estilo="btn-secundario"/>
                                        <graphic><Icono tipo="CLIENTES"/></graphic>
                                    </Button>
                                </HBox>
                                <Label text="Compras = ventas de productos + servicios realizados. Ordenado por número de compras." wrapText="true"><properties estilo="texto-ayuda"/></Label>
                                <TableView fx:id="tblClientes" prefHeight="230">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                                    <placeholder><Label text="Aún no hay compras registradas."><properties estilo="texto-ayuda"/></Label></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colCliPosicion" text="#" prefWidth="40" maxWidth="50"/>
                                        <TableColumn fx:id="colCliNombre" text="Cliente" prefWidth="200"/>
                                        <TableColumn fx:id="colCliCompras" text="Compras" prefWidth="80"/>
                                        <TableColumn fx:id="colCliIngresos" text="Ingresos generados" prefWidth="140"/>
                                    </columns>
                                </TableView>
                                <BarChart fx:id="chartClientes" title="Top 5 clientes por número de compras" animated="false"
                                          legendVisible="false" prefHeight="250" minHeight="220">
                                    <xAxis><CategoryAxis/></xAxis>
                                    <yAxis><NumberAxis label="Compras" minorTickVisible="false" tickUnit="1"/></yAxis>
                                </BarChart>
                            </VBox>

                            <VBox spacing="10" GridPane.columnIndex="1"><properties estilo="card"/>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Servicios más solicitados"><properties estilo="titulo-seccion"/>
                                        <graphic><Icono tipo="AGENDA" tamano="18"/></graphic>
                                    </Label>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Ver agenda" onAction="#abrirAgenda"><properties estilo="btn-secundario"/>
                                        <graphic><Icono tipo="AGENDA"/></graphic>
                                    </Button>
                                </HBox>
                                <Label text="Solicitudes = citas programadas o realizadas (sin canceladas). Ingresos = solo citas realizadas." wrapText="true"><properties estilo="texto-ayuda"/></Label>
                                <TableView fx:id="tblServicios" prefHeight="230">
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                                    <placeholder><Label text="Aún no hay servicios solicitados."><properties estilo="texto-ayuda"/></Label></placeholder>
                                    <columns>
                                        <TableColumn fx:id="colSerPosicion" text="#" prefWidth="40" maxWidth="50"/>
                                        <TableColumn fx:id="colSerNombre" text="Servicio" prefWidth="200"/>
                                        <TableColumn fx:id="colSerVeces" text="Solicitudes" prefWidth="90"/>
                                        <TableColumn fx:id="colSerIngresos" text="Ingresos" prefWidth="130"/>
                                    </columns>
                                </TableView>
                                <BarChart fx:id="chartServicios" title="Veces que se ha solicitado cada servicio" animated="false"
                                          legendVisible="false" prefHeight="250" minHeight="220">
                                    <xAxis><CategoryAxis/></xAxis>
                                    <yAxis><NumberAxis label="Solicitudes" minorTickVisible="false" tickUnit="1"/></yAxis>
                                </BarChart>
                            </VBox>
                        </GridPane>
                    </VBox>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>

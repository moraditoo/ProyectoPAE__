<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefWidth="1280.0" prefHeight="780.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.VentasController">

    <top>
        <HBox styleClass="header-bar, bg-turquesa">
            <FontIcon iconLiteral="fas-cash-register" iconSize="32"/>
            <VBox spacing="2">
                <Label text="Ventas" styleClass="header-title"/>
                <Label text="Venta de productos a clientes (descuenta stock del lote que vence primero)" styleClass="header-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="lblVentasHoy" styleClass="header-title" style="-fx-font-size: 18px;"/>
                <Label text="Vendido hoy" styleClass="header-subtitle"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <HBox styleClass="content-area">
            <!-- Nueva venta -->
            <VBox styleClass="card" prefWidth="460" minWidth="420">
                <Label text="Nueva venta" styleClass="card-title">
                    <graphic><FontIcon iconLiteral="fas-shopping-cart" iconSize="18"/></graphic>
                </Label>

                <Label text="Cliente *" styleClass="form-label"/>
                <ComboBox fx:id="cmbCliente" promptText="Seleccionar cliente..." maxWidth="Infinity"/>

                <Label text="Producto *" styleClass="form-label"/>
                <ComboBox fx:id="cmbProducto" promptText="Seleccionar producto con existencias..." maxWidth="Infinity"/>
                <Label fx:id="lblDisponible" styleClass="hint-label"/>

                <HBox spacing="10" alignment="BOTTOM_LEFT">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Cantidad *" styleClass="form-label"/>
                        <TextField fx:id="txtCantidad" promptText="Unidades" onAction="#handleAgregar"/>
                    </VBox>
                    <Button text="Agregar" onAction="#handleAgregar" styleClass="btn-success">
                        <graphic><FontIcon iconLiteral="fas-cart-plus" iconSize="15"/></graphic>
                    </Button>
                </HBox>

                <TableView fx:id="tblCarrito" VBox.vgrow="ALWAYS" minHeight="160">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="El carrito está vacío"/></placeholder>
                    <columns>
                        <TableColumn fx:id="colCarProducto" text="Producto" prefWidth="170"/>
                        <TableColumn fx:id="colCarCantidad" text="Cant." prefWidth="50"/>
                        <TableColumn fx:id="colCarPrecio" text="Precio" prefWidth="85"/>
                        <TableColumn fx:id="colCarSubtotal" text="Subtotal" prefWidth="95"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Button text="Quitar" onAction="#handleQuitar" styleClass="btn-secondary">
                        <graphic><FontIcon iconLiteral="fas-minus-circle" iconSize="14"/></graphic>
                    </Button>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER_RIGHT">
                        <Label fx:id="lblTotal" text="Total: C$ 0.00" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0891b2;"/>
                        <Label fx:id="lblGananciaEstimada" styleClass="hint-label"/>
                    </VBox>
                </HBox>

                <HBox spacing="10">
                    <Button text="Registrar venta" onAction="#handleRegistrarVenta" styleClass="btn-primary"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <graphic><FontIcon iconLiteral="fas-check-circle" iconSize="16"/></graphic>
                    </Button>
                    <Button text="Vaciar" onAction="#handleVaciar" styleClass="btn-secondary">
                        <graphic><FontIcon iconLiteral="fas-times" iconSize="15"/></graphic>
                    </Button>
                </HBox>
            </VBox>

            <!-- Historial -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                <Label text="Historial de ventas" styleClass="card-title">
                    <graphic><FontIcon iconLiteral="fas-receipt" iconSize="16"/></graphic>
                </Label>
                <TableView fx:id="tblVentas" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="Aún no hay ventas registradas"/></placeholder>
                    <columns>
                        <TableColumn fx:id="colVenId" text="N°" prefWidth="55" minWidth="45" maxWidth="70"/>
                        <TableColumn fx:id="colVenFecha" text="Fecha" prefWidth="160"/>
                        <TableColumn fx:id="colVenCliente" text="Cliente" prefWidth="200"/>
                        <TableColumn fx:id="colVenTotal" text="Total" prefWidth="110"/>
                        <TableColumn fx:id="colVenGanancia" text="Ganancia" prefWidth="110"/>
                    </columns>
                </TableView>

                <Label text="Detalle de la venta seleccionada" styleClass="card-title">
                    <graphic><FontIcon iconLiteral="fas-file-invoice-dollar" iconSize="16"/></graphic>
                </Label>
                <TableView fx:id="tblDetalle" prefHeight="190" minHeight="140">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="Seleccione una venta del historial"/></placeholder>
                    <columns>
                        <TableColumn fx:id="colDetProducto" text="Producto" prefWidth="220"/>
                        <TableColumn fx:id="colDetCantidad" text="Cantidad" prefWidth="80"/>
                        <TableColumn fx:id="colDetPrecio" text="Precio venta" prefWidth="110"/>
                        <TableColumn fx:id="colDetCosto" text="Precio compra" prefWidth="110"/>
                        <TableColumn fx:id="colDetSubtotal" text="Subtotal" prefWidth="110"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import ni.edu.uam.proyectopae.util.Icono?>

<BorderPane prefWidth="1200.0" prefHeight="760.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.VentasController">
    <top>
        <HBox alignment="CENTER_LEFT"><properties estilo="encabezado-modulo"/>
            <Icono tipo="VENTAS" tamano="30"><properties estilo="icono-encabezado"/></Icono>
            <VBox>
                <Label text="Ventas"><properties estilo="titulo-modulo"/></Label>
                <Label text="Venta de productos a clientes con descuento automático de existencias por lote"><properties estilo="subtitulo-modulo"/></Label>
            </VBox>
        </HBox>
    </top>

    <center>
        <HBox><properties estilo="contenido-modulo"/>
            <!-- Nueva venta -->
            <VBox spacing="12" prefWidth="470" minWidth="470" maxWidth="520"><properties estilo="card"/>
                <Label text="Nueva venta"><properties estilo="titulo-seccion"/>
                    <graphic><Icono tipo="VENTAS" tamano="18"/></graphic>
                </Label>

                <VBox spacing="5">
                    <Label text="Cliente *"><properties estilo="etiqueta-campo"/>
                        <graphic><Icono tipo="PERSONA" tamano="14"/></graphic>
                    </Label>
                    <ComboBox fx:id="cmbCliente" promptText="Seleccionar cliente..."/>
                </VBox>

                <GridPane hgap="10" vgap="5">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="62"/>
                        <ColumnConstraints percentWidth="38"/>
                    </columnConstraints>
                    <Label text="Producto *" GridPane.rowIndex="0" GridPane.columnIndex="0"><properties estilo="etiqueta-campo"/></Label>
                    <Label text="Cantidad *" GridPane.rowIndex="0" GridPane.columnIndex="1"><properties estilo="etiqueta-campo"/></Label>
                    <ComboBox fx:id="cmbProducto" promptText="Seleccionar producto..." GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCantidad" promptText="Ej: 2" onAction="#handleAgregarProducto" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>
                <Label fx:id="lblDisponible" wrapText="true"><properties estilo="texto-ayuda"/></Label>

                <HBox spacing="10">
                    <Button text="Agregar" onAction="#handleAgregarProducto"><properties estilo="btn-secundario"/>
                        <graphic><Icono tipo="NUEVO"/></graphic>
                    </Button>
                    <Button text="Quitar" onAction="#handleQuitarProducto"><properties estilo="btn-secundario"/>
                        <graphic><Icono tipo="QUITAR"/></graphic>
                    </Button>
                </HBox>

                <TableView fx:id="tblDetalle" VBox.vgrow="ALWAYS" prefHeight="200">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <placeholder><Label text="Agregue productos a la venta."><properties estilo="texto-ayuda"/></Label></placeholder>
                    <columns>
                        <TableColumn fx:id="colDetProducto" text="Producto" prefWidth="170"/>
                        <TableColumn fx:id="colDetCantidad" text="Cant." prefWidth="55"/>
                        <TableColumn fx:id="colDetPrecio" text="Precio" prefWidth="90"/>
                        <TableColumn fx:id="colDetSubtotal" text="Subtotal" prefWidth="100"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Total:"><properties estilo="titulo-seccion"/></Label>
                    <Label fx:id="lblTotal" text="C$ 0.00"><properties estilo="total-venta"/></Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Nueva" onAction="#handleNuevaVenta"><properties estilo="btn-secundario"/>
                        <graphic><Icono tipo="NUEVO"/></graphic>
                        <tooltip><Tooltip text="Descarta la venta en curso"/></tooltip>
                    </Button>
                    <Button text="Guardar" onAction="#handleGuardarVenta"><properties estilo="btn-primario"/>
                        <graphic><Icono tipo="GUARDAR"/></graphic>
                        <tooltip><Tooltip text="Registra la venta y descuenta las existencias"/></tooltip>
                    </Button>
                </HBox>
            </VBox>

            <!-- Historial -->
            <VBox spacing="12" HBox.hgrow="ALWAYS"><properties estilo="card"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Historial de ventas"><properties estilo="titulo-seccion"/>
                        <graphic><Icono tipo="TENDENCIA" tamano="18"/></graphic>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button onAction="#refrescarTabla"><properties estilo="btn-secundario"/>
                        <graphic><Icono tipo="REFRESCAR"/></graphic>
                        <tooltip><Tooltip text="Recargar desde la base de datos"/></tooltip>
                    </Button>
                </HBox>

                <TableView fx:id="tblVentas" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <placeholder><Label text="Aún no hay ventas registradas."><properties estilo="texto-ayuda"/></Label></placeholder>
                    <columns>
                        <TableColumn fx:id="colVentaId" text="N.º" prefWidth="55" maxWidth="70"/>
                        <TableColumn fx:id="colVentaFecha" text="Fecha" prefWidth="160"/>
                        <TableColumn fx:id="colVentaCliente" text="Cliente" prefWidth="200"/>
                        <TableColumn fx:id="colVentaTotal" text="Total" prefWidth="110"/>
                        <TableColumn fx:id="colVentaCosto" text="Costo" prefWidth="110"/>
                        <TableColumn fx:id="colVentaGanancia" text="Ganancia" prefWidth="110"/>
                    </columns>
                </TableView>

                <Label text="Productos de la venta seleccionada"><properties estilo="etiqueta-campo"/></Label>
                <TableView fx:id="tblDetalleHistorial" prefHeight="170" minHeight="120">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <placeholder><Label text="Seleccione una venta para ver su detalle."><properties estilo="texto-ayuda"/></Label></placeholder>
                    <columns>
                        <TableColumn fx:id="colHistProducto" text="Producto" prefWidth="220"/>
                        <TableColumn fx:id="colHistCantidad" text="Cantidad" prefWidth="80"/>
                        <TableColumn fx:id="colHistPrecio" text="Precio de venta" prefWidth="120"/>
                        <TableColumn fx:id="colHistCosto" text="Precio de compra" prefWidth="120"/>
                        <TableColumn fx:id="colHistSubtotal" text="Subtotal" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="pae-ui" prefWidth="1280.0" prefHeight="800.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.DashboardInventarioController">

    <top>
        <HBox styleClass="encabezado-modulo" spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Dashboard de inventario" styleClass="header-title"/>
                <Label text="Revisa vencimientos y repón productos bajo el stock mínimo." styleClass="header-subtitle" wrapText="true"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox styleClass="content-area" spacing="20" minWidth="835">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Vencen en los próximos" styleClass="form-label"/>
                    <ComboBox fx:id="cmbDias" prefWidth="135"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Actualizar" onAction="#handleActualizar" styleClass="btn-secondary">
                        <graphic><FontIcon iconLiteral="fas-sync-alt" iconSize="14"/></graphic>
                    </Button>
                </HBox>

                <HBox spacing="16">
                    <VBox styleClass="kpi-card" spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="290" minHeight="112">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Productos en catálogo" wrapText="true"
                                   styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <StackPane styleClass="chip-lila" minWidth="30" minHeight="30">
                                <FontIcon iconLiteral="fas-box-open" iconSize="15"/>
                            </StackPane>
                        </HBox>
                        <Label fx:id="lblKpiProductos" text="0" styleClass="kpi-valor"/>
                    </VBox>
                    <VBox styleClass="kpi-card" spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="290" minHeight="112">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="lblKpiPorVencerTitulo" text="Lotes por vencer" wrapText="true"
                                   styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <StackPane styleClass="chip-ambar" minWidth="30" minHeight="30">
                                <FontIcon iconLiteral="far-clock" iconSize="15"/>
                            </StackPane>
                        </HBox>
                        <Label fx:id="lblKpiPorVencer" text="0" styleClass="kpi-valor"/>
                    </VBox>
                    <VBox styleClass="kpi-card" spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="290" minHeight="112">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Lotes vencidos con stock" wrapText="true"
                                   styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <StackPane styleClass="chip-rosa" minWidth="30" minHeight="30">
                                <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="15"/>
                            </StackPane>
                        </HBox>
                        <Label fx:id="lblKpiVencidos" text="0" styleClass="kpi-valor"/>
                    </VBox>
                    <VBox styleClass="kpi-card" spacing="5" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefWidth="290" minHeight="112">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Bajo el stock mínimo" wrapText="true"
                                   styleClass="kpi-titulo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <StackPane styleClass="chip-verde" minWidth="30" minHeight="30">
                                <FontIcon iconLiteral="fas-th-large" iconSize="15"/>
                            </StackPane>
                        </HBox>
                        <Label fx:id="lblKpiBajoMinimo" text="0" styleClass="kpi-valor"/>
                    </VBox>
                </HBox>

                <!-- Tablas -->
                <HBox spacing="14">
                    <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblTituloPorVencer" text="Productos por vencer" styleClass="card-title">
                            <graphic><FontIcon iconLiteral="fas-hourglass-end" iconSize="16"/></graphic>
                        </Label>
                        <TableView fx:id="tblPorVencer" prefHeight="260">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                            <placeholder><Label text="Ningún lote por vencer en este periodo"/></placeholder>
                            <columns>
                                <TableColumn fx:id="colPvProducto" text="Producto" prefWidth="240" minWidth="170"/>
                                <TableColumn fx:id="colPvLote" text="Lote" prefWidth="110"/>
                                <TableColumn fx:id="colPvFecha" text="Caduca" prefWidth="95"/>
                                <TableColumn fx:id="colPvDias" text="Días" prefWidth="60"/>
                                <TableColumn fx:id="colPvCantidad" text="Unidades" prefWidth="75"/>
                                <TableColumn fx:id="colPvEstado" text="Estado" prefWidth="95"/>
                            </columns>
                        </TableView>
                    </VBox>
                    <VBox styleClass="card" prefWidth="490" minWidth="330" spacing="12">
                        <Label text="Productos bajo el stock mínimo" styleClass="card-title">
                            <graphic><FontIcon iconLiteral="fas-exclamation-circle" iconSize="16"/></graphic>
                        </Label>
                        <TableView fx:id="tblBajoMinimo" prefHeight="260">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                            <placeholder><Label text="Todos los productos cumplen el mínimo"/></placeholder>
                            <columns>
                                <TableColumn fx:id="colBmProducto" text="Producto" prefWidth="240" minWidth="170"/>
                                <TableColumn fx:id="colBmStock" text="Stock" prefWidth="70"/>
                                <TableColumn fx:id="colBmMinimo" text="Mínimo" prefWidth="70"/>
                                <TableColumn fx:id="colBmFaltante" text="Reponer" prefWidth="75"/>
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

                <!-- Graficos -->
                <HBox spacing="14">
                    <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
                        <BarChart fx:id="chartStock" styleClass="chart-stock" title="Stock actual vs. stock mínimo"
                                  animated="false" legendSide="BOTTOM" prefHeight="300">
                            <xAxis><CategoryAxis fx:id="ejeProductos"/></xAxis>
                            <yAxis><NumberAxis label="Unidades" minorTickVisible="false"/></yAxis>
                        </BarChart>
                    </VBox>
                    <VBox styleClass="card" prefWidth="420" minWidth="300" spacing="12">
                        <PieChart fx:id="chartEstadoLotes" styleClass="pie-lotes" title="Estado de los lotes con stock"
                                  animated="false" legendSide="BOTTOM" labelsVisible="true" prefHeight="300"/>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>

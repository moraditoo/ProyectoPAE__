<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" prefWidth="920.0" prefHeight="580.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectopae.controllers.LotesServiciosController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Control de Lotes de Insumos y Monitoreo de Caducidad" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Producto Relacionado:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbProducto" prefWidth="250" promptText="Seleccionar producto de BD..." GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Código de Lote:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="txtCodigoLote" promptText="Ej: LOT-2026-A1" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Fecha de Caducidad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpFechaCaducidad" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Cantidad Ingresada:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <TextField fx:id="txtCantidad" promptText="Unidades (entero)" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Registrar / Actualizar Lote" onAction="#handleGuardarLote" style="-fx-background-color: #0078d7; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Limpiar" onAction="#handleLimpiar"/>
        <Button text="Eliminar Lote" onAction="#handleEliminarLote" style="-fx-background-color: #d83b01; -fx-text-fill: white;"/>
        <Button text="Sincronizar con BD" onAction="#refrescarTabla"/>
        <Label fx:id="lblEstado" wrapText="true"/>
    </HBox>

    <TableView fx:id="tblLotes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colProducto" text="Producto Cosmético" prefWidth="280"/>
            <TableColumn fx:id="colCodigo" text="Código de Lote" prefWidth="180"/>
            <TableColumn fx:id="colCaducidad" text="Fecha de Caducidad" prefWidth="160"/>
            <TableColumn fx:id="colCantidad" text="Stock Disponible" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import ni.edu.uam.proyectopae.util.Icono?>

<BorderPane prefWidth="1200.0" prefHeight="760.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.AgendaController">
    <top>
        <HBox alignment="CENTER_LEFT"><properties estilo="encabezado-modulo"/>
            <Icono tipo="AGENDA" tamano="30"><properties estilo="icono-encabezado"/></Icono>
            <VBox>
                <Label text="Agenda de Citas"><properties estilo="titulo-modulo"/></Label>
                <Label text="Programación de servicios de maquillaje y control de turnos"><properties estilo="subtitulo-modulo"/></Label>
            </VBox>
        </HBox>
    </top>

    <center>
        <HBox><properties estilo="contenido-modulo"/>
            <!-- Formulario -->
            <VBox spacing="12" prefWidth="430" minWidth="430" maxWidth="460"><properties estilo="card"/>
                <Label text="Nueva cita"><properties estilo="titulo-seccion"/>
                    <graphic><Icono tipo="AGENDA" tamano="18"/></graphic>
                </Label>

                <VBox spacing="5">
                    <Label text="Buscar cliente *"><properties estilo="etiqueta-campo"/>
                        <graphic><Icono tipo="BUSCAR" tamano="14"/></graphic>
                    </Label>
                    <TextField fx:id="txtBuscarCliente" promptText="Nombre, apellido, teléfono o correo..."/>
                    <ListView fx:id="lstClientesCoincidentes" prefHeight="150.0" VBox.vgrow="SOMETIMES"/>
                    <Label fx:id="lblClienteSeleccionado" text="Ningún cliente seleccionado" wrapText="true"><properties estilo="indicador-modo"/></Label>
                </VBox>

                <VBox spacing="5">
                    <Label text="Servicio *"><properties estilo="etiqueta-campo"/></Label>
                    <ComboBox fx:id="cmbServicio" promptText="Seleccionar servicio..."/>
                </VBox>

                <GridPane hgap="12" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="55"/>
                        <ColumnConstraints percentWidth="45"/>
                    </columnConstraints>
                    <VBox spacing="5" GridPane.columnIndex="0">
                        <Label text="Fecha *"><properties estilo="etiqueta-campo"/></Label>
                        <DatePicker fx:id="dpFecha" promptText="dd/mm/aaaa"/>
                    </VBox>
                    <VBox spacing="5" GridPane.columnIndex="1">
                        <Label text="Hora *"><properties estilo="etiqueta-campo"/>
                            <graphic><Icono tipo="RELOJ" tamano="14"/></graphic>
                        </Label>
                        <ComboBox fx:id="cmbHora" promptText="Hora..."/>
                    </VBox>
                </GridPane>

                <Button text="Agendar cita" onAction="#handleAgendarCita" maxWidth="Infinity"><properties estilo="btn-primario"/>
                    <graphic><Icono tipo="GUARDAR"/></graphic>
                </Button>
            </VBox>

            <!-- Listado -->
            <VBox spacing="12" HBox.hgrow="ALWAYS"><properties estilo="card"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Citas registradas"><properties estilo="titulo-seccion"/>
                        <graphic><Icono tipo="AGENDA" tamano="18"/></graphic>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Resumen por servicio" onAction="#handleGenerarResumenHQL"><properties estilo="btn-secundario"/>
                        <graphic><Icono tipo="GRAFICO"/></graphic>
                    </Button>
                    <Button onAction="#handleRecargarTodo"><properties estilo="btn-secundario"/>
                        <graphic><Icono tipo="REFRESCAR"/></graphic>
                        <tooltip><Tooltip text="Recargar desde la base de datos"/></tooltip>
                    </Button>
                </HBox>

                <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                    <placeholder><Label text="No hay citas registradas."><properties estilo="texto-ayuda"/></Label></placeholder>
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="55" maxWidth="70"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="220"/>
                        <TableColumn fx:id="colServicio" text="Servicio" prefWidth="220"/>
                        <TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="160"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="140"/>
                    </columns>
                </TableView>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Con la cita seleccionada:"><properties estilo="texto-ayuda"/></Label>
                    <Button text="Marcar como realizada" onAction="#handleMarcarRealizada"><properties estilo="btn-exito"/>
                        <graphic><Icono tipo="EXITO"/></graphic>
                        <tooltip><Tooltip text="El servicio se cobró: se suma a los ingresos del Dashboard"/></tooltip>
                    </Button>
                    <Button text="Cancelar cita" onAction="#handleCancelarCita"><properties estilo="btn-peligro"/>
                        <graphic><Icono tipo="CANCELAR"/></graphic>
                    </Button>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>

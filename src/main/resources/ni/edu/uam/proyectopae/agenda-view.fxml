<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane styleClass="pae-ui" prefWidth="1250.0" prefHeight="760.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.AgendaController">

    <top>
        <HBox styleClass="encabezado-modulo" spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Agenda de citas" styleClass="header-title"/>
                <Label text="Programa y da seguimiento a los servicios de maquillaje." styleClass="header-subtitle" wrapText="true"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <HBox styleClass="content-area" spacing="18" minHeight="540" minWidth="820" alignment="TOP_LEFT">
                <VBox styleClass="card" spacing="9" prefWidth="365" minWidth="320" maxHeight="-Infinity">
                    <Label text="Agendar cita" styleClass="card-title"/>
                    <Label text="Cliente *" styleClass="form-label"/>
                    <TextField fx:id="txtBuscarCliente" promptText="Buscar por nombre, apellido o teléfono"/>
                    <ListView fx:id="lstClientesCoincidentes" prefHeight="100" minHeight="75"/>
                    <Label fx:id="lblClienteSeleccionado" text="Ningún cliente seleccionado" styleClass="modo-label" wrapText="true"/>
                    <Label text="Servicio *" styleClass="form-label"/>
                    <ComboBox fx:id="cmbServicio" promptText="Seleccionar servicio..." maxWidth="Infinity"/>
                    <HBox spacing="10">
                        <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="Fecha *" styleClass="form-label"/>
                            <DatePicker fx:id="dpFecha" promptText="Fecha..." maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS" minWidth="0">
                            <Label text="Hora *" styleClass="form-label"/>
                            <ComboBox fx:id="cmbHora" promptText="Hora..." maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <Button text="Agendar cita" onAction="#handleAgendarCita" styleClass="btn-primary"/>
                </VBox>
                <VBox styleClass="card" spacing="14" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Citas registradas" styleClass="card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Ingresos proyectados" onAction="#handleGenerarResumenHQL"
                                styleClass="btn-secondary"/>
                    </HBox>
                    <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                        <placeholder><Label text="No hay citas registradas"/></placeholder>
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50" minWidth="45" maxWidth="70"/>
                            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="250"/>
                            <TableColumn fx:id="colServicio" text="Servicio" prefWidth="240"/>
                            <TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="180"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
                        </columns>
                    </TableView>
                    <HBox spacing="8">
                        <Button text="Completar cita" onAction="#handleCompletarCita" styleClass="btn-secondary"/>
                        <Button text="Cancelar cita" onAction="#handleCancelarCita" styleClass="btn-danger"/>
                    </HBox>
                </VBox>
            </HBox>
        </ScrollPane>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefWidth="1250.0" prefHeight="760.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.AgendaController">

    <top>
        <HBox styleClass="header-bar, bg-indigo">
            <FontIcon iconLiteral="fas-calendar-alt" iconSize="32"/>
            <VBox spacing="2">
                <Label text="Agenda de Citas" styleClass="header-title"/>
                <Label text="Calendarización de servicios de maquillaje" styleClass="header-subtitle"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <VBox styleClass="content-area">
            <HBox spacing="14">
                <!-- Buscador reactivo de clientes -->
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="1. Seleccione el cliente" styleClass="card-title">
                        <graphic><FontIcon iconLiteral="fas-user-check" iconSize="16"/></graphic>
                    </Label>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="fas-search" iconSize="15"/>
                        <TextField fx:id="txtBuscarCliente" promptText="Escriba nombre, apellido o teléfono..." HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ListView fx:id="lstClientesCoincidentes" prefHeight="120.0"/>
                    <Label fx:id="lblClienteSeleccionado" text="Ningún cliente seleccionado" styleClass="modo-label" wrapText="true"/>
                </VBox>

                <!-- Datos de la cita -->
                <VBox styleClass="card" prefWidth="400" minWidth="360">
                    <Label text="2. Datos de la cita" styleClass="card-title">
                        <graphic><FontIcon iconLiteral="fas-clipboard-check" iconSize="16"/></graphic>
                    </Label>
                    <Label text="Servicio *" styleClass="form-label"/>
                    <ComboBox fx:id="cmbServicio" promptText="Seleccionar servicio..." maxWidth="Infinity"/>
                    <HBox spacing="10">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Fecha *" styleClass="form-label"/>
                            <DatePicker fx:id="dpFecha" promptText="Fecha..." maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Hora *" styleClass="form-label"/>
                            <ComboBox fx:id="cmbHora" promptText="Hora..." maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <Button text="Agendar cita" onAction="#handleAgendarCita" styleClass="btn-primary" maxWidth="Infinity">
                        <graphic><FontIcon iconLiteral="fas-calendar-plus" iconSize="16"/></graphic>
                    </Button>
                </VBox>
            </HBox>

            <!-- Citas -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Citas registradas" styleClass="card-title">
                        <graphic><FontIcon iconLiteral="fas-list" iconSize="16"/></graphic>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Completar cita" onAction="#handleCompletarCita" styleClass="btn-success">
                        <graphic><FontIcon iconLiteral="fas-check" iconSize="14"/></graphic>
                    </Button>
                    <Button text="Cancelar cita" onAction="#handleCancelarCita" styleClass="btn-danger">
                        <graphic><FontIcon iconLiteral="fas-ban" iconSize="14"/></graphic>
                    </Button>
                    <Button text="Ingresos proyectados" onAction="#handleGenerarResumenHQL" styleClass="btn-dark">
                        <graphic><FontIcon iconLiteral="fas-chart-bar" iconSize="14"/></graphic>
                    </Button>
                </HBox>
                <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="No hay citas registradas"/></placeholder>
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50" minWidth="45" maxWidth="70"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="250"/>
                        <TableColumn fx:id="colServicio" text="Servicio" prefWidth="240"/>
                        <TableColumn fx:id="colFecha" text="Fecha y hora" prefWidth="180"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>

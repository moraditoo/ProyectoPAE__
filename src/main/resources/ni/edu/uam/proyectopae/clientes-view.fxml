<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefWidth="1200.0" prefHeight="720.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectopae.controllers.ClienteController">

    <top>
        <HBox styleClass="header-bar, bg-morado">
            <FontIcon iconLiteral="fas-users" iconSize="32"/>
            <VBox spacing="2">
                <Label text="Clientes" styleClass="header-title"/>
                <Label text="Registro y administración de clientes" styleClass="header-subtitle"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <HBox styleClass="content-area">
            <!-- Formulario -->
            <VBox styleClass="card" prefWidth="370" minWidth="340">
                <Label text="Registro de Cliente" styleClass="card-title">
                    <graphic><FontIcon iconLiteral="fas-user-plus" iconSize="18"/></graphic>
                </Label>
                <Label fx:id="lblModo" text="Nuevo cliente" styleClass="modo-label"/>

                <Label text="Nombres *" styleClass="form-label"/>
                <TextField fx:id="txtNombres" promptText="Nombres del cliente"/>

                <Label text="Apellidos *" styleClass="form-label"/>
                <TextField fx:id="txtApellidos" promptText="Apellidos del cliente"/>

                <Label text="Sexo *" styleClass="form-label"/>
                <ComboBox fx:id="cmbSexo" promptText="Seleccionar..." maxWidth="Infinity"/>

                <Label text="Teléfono" styleClass="form-label"/>
                <TextField fx:id="txtTelefono" promptText="Ej: 88887777"/>

                <Label text="Correo electrónico" styleClass="form-label"/>
                <TextField fx:id="txtCorreo" promptText="Ej: cliente@correo.com"/>

                <Label text="Alergias / Sensibilidad dérmica" styleClass="form-label"/>
                <TextArea fx:id="txtAlergias" promptText="Ninguna, piel atópica, reactiva a parabenos..."
                          prefRowCount="3" wrapText="true"/>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Un solo boton registra (nuevo) o actualiza (seleccionado) en la BD -->
                <Button fx:id="btnGuardar" text="Guardar" onAction="#handleGuardarCliente"
                        styleClass="btn-primary" maxWidth="Infinity">
                    <graphic><FontIcon iconLiteral="fas-save" iconSize="16"/></graphic>
                </Button>
                <HBox spacing="10">
                    <Button text="Nuevo" onAction="#handleLimpiarCampos" styleClass="btn-secondary"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <graphic><FontIcon iconLiteral="fas-broom" iconSize="15"/></graphic>
                    </Button>
                    <Button text="Eliminar" onAction="#handleEliminarCliente" styleClass="btn-danger"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <graphic><FontIcon iconLiteral="fas-trash-alt" iconSize="15"/></graphic>
                    </Button>
                </HBox>
            </VBox>

            <!-- Listado -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Clientes registrados" styleClass="card-title">
                        <graphic><FontIcon iconLiteral="fas-list" iconSize="16"/></graphic>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <FontIcon iconLiteral="fas-search" iconSize="16"/>
                    <TextField fx:id="txtBuscar" promptText="Buscar por nombre, teléfono o correo..." prefWidth="300"/>
                </HBox>

                <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <placeholder><Label text="No hay clientes registrados"/></placeholder>
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="55" minWidth="45" maxWidth="70"/>
                        <TableColumn fx:id="colNombres" text="Nombres" prefWidth="140"/>
                        <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="140"/>
                        <TableColumn fx:id="colSexo" text="Sexo" prefWidth="90"/>
                        <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="110"/>
                        <TableColumn fx:id="colCorreo" text="Correo electrónico" prefWidth="190"/>
                        <TableColumn fx:id="colAlergias" text="Alergias" prefWidth="200"/>
                    </columns>
                </TableView>
                <Label fx:id="lblTotal" styleClass="hint-label"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12.0" prefWidth="360.0" prefHeight="320.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectopae.controllers.LoginController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Tienda de Maquillaje" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="Acceso al Sistema (PAE)" style="-fx-font-size: 13px; -fx-text-fill: #555;"/>

    <TextField fx:id="txtUsuario" promptText="Usuario" onKeyPressed="#handleEnterLogin"/>
    <PasswordField fx:id="txtPassword" promptText="Contraseña" onKeyPressed="#handleEnterLogin"/>

    <Button text="Iniciar Sesión" onAction="#handleLogin" maxWidth="Infinity"
            style="-fx-background-color: #2b5797; -fx-text-fill: white; -fx-font-weight: bold;"/>
    <Label fx:id="lblMensaje" wrapText="true"/>
</VBox>
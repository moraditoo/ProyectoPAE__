<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" prefWidth="920.0" prefHeight="580.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectopae.controllers.InventarioController">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Gestión de Catálogo de Productos (Inventario General)" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <Label text="Nombre del Producto:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" promptText="Ej: Base Líquida Fit Me" onKeyPressed="#handleEnterGuardar" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Precio Unitario (C$):" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="txtPrecio" promptText="Ej: 380.00" onKeyPressed="#handleEnterGuardar" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

        <Label text="Categoría:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbCategoria" prefWidth="220" promptText="Seleccionar..." GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Marca:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
        <ComboBox fx:id="cmbMarca" prefWidth="220" promptText="Seleccionar..." GridPane.rowIndex="1" GridPane.columnIndex="3"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Guardar Producto" onAction="#handleGuardarProducto"
                style="-fx-background-color: #2b5797; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Limpiar Formulario" onAction="#handleLimpiar"/>
        <Button text="Eliminar Producto" onAction="#handleEliminarProducto"
                style="-fx-background-color: #b30000; -fx-text-fill: white;"/>
        <Button text="Recargar de BD" onAction="#refrescarTabla"/>
        <Label fx:id="lblEstado" wrapText="true"/>
    </HBox>

    <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNombre" text="Nombre del Cosmético" prefWidth="280"/>
            <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="180"/>
            <TableColumn fx:id="colMarca" text="Marca" prefWidth="180"/>
            <TableColumn fx:id="colPrecio" text="Precio Unitario" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>